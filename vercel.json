{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "prisma generate && prisma migrate deploy && next build",
  "functions": {
    "pages/api/cron/*.ts": {
      "maxDuration": 300
    },
    "pages/api/site/users/[userid]/delete.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/update-sessions",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/close-stale-sessions",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/reset-activity",
      "schedule": "5 * * * *"
    },
    {
      "path": "/api/cron/update-roles",
      "schedule": "20 * * * *"
    },
    {
      "path": "/api/cron/update-users",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/birthdays",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/plans",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/team-reminders",
      "schedule": "10 * * * *"
    }
  ]
}
